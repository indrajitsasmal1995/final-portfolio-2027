{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "indrajitwork.vercel.app"
        }
      ],
      "destination": "https://indrajit.work/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "indrajitwork.vercel.app"
        }
      ],
      "destination": "https://indrajit.work/:path*",
      "permanent": true
    },
    {
      "source": "/zbrain",
      "destination": "/zbrain-v2",
      "permanent": false
    },
    {
      "source": "/ce-copilot",
      "destination": "/ce-copilot-v2",
      "permanent": false
    },
    {
      "source": "/finora",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/carrom-scorer",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/carrom-scorer-landing",
      "destination": "/",
      "permanent": false
    }
  ]
}